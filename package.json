{
  "name": "html2realpdf-landing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "docs:generate": "node scripts/generate-api-docs.mjs",
    "playground:generate": "node scripts/generate-playground-assets.mjs",
    "docs:validate": "node scripts/validate-docs.mjs",
    "docs:check": "npm run docs:generate -- --check && npm run docs:validate && fumadocs-mdx",
    "docs:dev": "npm run docs:generate && next dev",
    "docs:build": "npm run docs:generate && npm run docs:validate && next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@imggion/html2realpdf": "0.2.0",
    "@lezer/highlight": "^1.2.3",
    "@vercel/analytics": "^2.0.1",
    "cmdk": "^1.1.1",
    "codemirror": "^6.0.2",
    "fumadocs-core": "^16.12.1",
    "fumadocs-mdx": "^15.2.0",
    "html2pdf.js": "^0.14.0",
    "next": "16.2.10",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shiki": "4.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.19.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.10",
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.19"
  }
}
